.btn{
  display:inline-block;
  padding:11px 22px;
  border:1px solid var(--line-strong);
  border-radius:999px;
  background:transparent;
  color:var(--ink);
  font:inherit; font-size:15px;
  text-decoration:none;
  cursor:pointer;
  transition:background-color .18s ease, border-color .18s ease, color .18s ease;
}
.btn:hover{ background:rgba(185,198,214,.09); border-color:var(--accent-deep) }
.btn--primary{ background:var(--ink); border-color:var(--ink); color:#0b0b0d; font-weight:600 }
.btn--primary:hover{ background:#fff; border-color:#fff; color:#000 }
.btn--ghost{ padding:9px 18px; font-size:14.5px }
.btn:focus-visible{ outline:2px solid var(--accent); outline-offset:3px }

/* ==========================================================================
   1. Hero
   ========================================================================== */
.hero{
  position:relative;
  padding:88px 0 80px;
  overflow:hidden;
}
/* 水墨纹理只做氛围层：低透明度、只覆盖首屏 */
.hero::before{
  content:"";
  position:absolute; inset:0;
  background:url("assets/img/ui/bg-title.jpg") center/cover no-repeat;
  opacity:.07;
  mix-blend-mode:screen;
  pointer-events:none;
}
.hero__grid{
  position:relative;
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:56px;
  align-items:center;
}
.eyebrow{
  margin:0 0 18px;
  font-size:12.5px; letter-spacing:.22em; text-transform:uppercase;
  color:var(--accent);
}
.hero__title{
  margin:0;
  font-size:clamp(44px,7.4vw,80px);
  font-weight:400;
  letter-spacing:.14em;
  line-height:1.08;
  color:#fff;
}
.hero__sub{
  margin:10px 0 0;
  font-size:clamp(17px,2.1vw,21px);
  letter-spacing:.18em;
  color:var(--ink-dim);
}
.hero__lead{
  margin:30px 0 0;
  max-width:34em;
  color:var(--ink-dim);
}
.hero__specs{
  display:flex; flex-wrap:wrap; gap:0 14px;
  margin:26px 0 0; padding:0; list-style:none;
  font-size:14px; color:var(--ink-mute);
}
.hero__specs li{ display:flex; align-items:center; gap:14px }
.hero__specs li::after{ content:""; width:1px; height:11px; background:var(--line-strong) }
.hero__specs li:last-child::after{ display:none }
.hero__actions{ margin:34px 0 0; display:flex; flex-wrap:wrap; gap:12px }

.hero__device{ justify-self:end }
.device-cap{
  margin:16px 0 0; text-align:center;
  font-size:13px; color:var(--ink-mute); letter-spacing:.06em;
}

/* ---------------- 手表外壳（CSS 画的方形表壳） ---------------- */
.watch{ position:relative; display:inline-block }
.watch__bezel{
  padding:15px;
  border:1px solid var(--line-strong);
  border-radius:48px;
  background:linear-gradient(160deg,#17181d 0%,#0e0f12 46%,#131418 100%);
  box-shadow:0 28px 70px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.045);
}
.watch__shot{
  width:390px; max-width:100%;
  border-radius:34px;
  background:#000;
}
.watch__crown{
  position:absolute; right:-6px; top:25%;
  width:7px; height:50px;
  border-radius:0 4px 4px 0;
  background:linear-gradient(90deg,#2c2f35,#4a5862 60%,#22252a);
}

/* ==========================================================================
   2. 三张要点卡
   ========================================================================== */
.cards{
  display:grid; grid-template-columns:repeat(3,minmax(0,1fr));
  gap:36px 40px;
  margin:0; padding:0; list-style:none;
}
.card{ padding-top:20px; border-top:1px solid var(--line-strong) }
.card h3{
  margin:0 0 10px;
  font-size:17px; font-weight:600; letter-spacing:.08em;
}
.card p{ margin:0; color:var(--ink-dim); font-size:15.5px }

/* ==========================================================================
   3. 可玩区
   ========================================================================== */
.sec--play{ background:var(--bg-soft) }
.play{
  display:grid;
  grid-template-columns:minmax(0,420px) minmax(0,1fr);
  gap:52px;
  align-items:start;
}
.play__device{ min-width:0 }
.play__h{ margin:0 0 18px; font-size:15px; letter-spacing:.16em; color:var(--accent) }

.keys{ margin:0; padding:0; list-style:none; color:var(--ink-dim); font-size:15.5px }
.keys li{ padding:9px 0; border-bottom:1px solid var(--line) }
.keys li:last-child{ border-bottom:0 }
kbd{
  display:inline-block;
  padding:1px 7px; margin:0 1px;
  border:1px solid var(--line-strong); border-bottom-width:2px;
  border-radius:5px;
  background:#17181c;
  font:500 13px/1.7 Consolas,"Cascadia Mono",monospace;
  color:var(--ink);
}
.play__note{
  margin:20px 0 0; max-width:40em;
  color:var(--ink-dim); font-size:15px; line-height:1.85;
}
.play__note:first-of-type{
  padding-left:14px; border-left:3px solid var(--accent-deep);
  color:var(--ink);
}
.play__tools{ margin:26px 0 0; display:flex; flex-wrap:wrap; gap:10px }
.play__hint{ margin:14px 0 0; font-size:13.5px; color:var(--ink-mute) }

.play__status{
  min-height:22px; margin:16px 0 0; text-align:center;
  font-size:13.5px; color:var(--accent);
  opacity:0; transition:opacity .2s ease;
}
.play__status.is-on{ opacity:1 }

/* ---------------- 表盘坐标系（466 x 538 设计单位） ---------------- */
.watch--play .watch__bezel{ padding:14px; border-radius:44px }
.screen-wrap{
  position:relative;
  overflow:hidden;
  border-radius:32px;
  background:#000;
}
.stage{
  position:absolute; left:0; top:0;
  width:466px; height:538px;
  transform-origin:0 0;
  background:#000;
  cursor:pointer;
  outline:none;
  touch-action:none;
  -webkit-tap-highlight-color:transparent;
}
.stage:focus-visible{ box-shadow:inset 0 0 0 3px var(--accent) }

.scene{ position:absolute; inset:0 }
.stage img{ position:absolute; display:block; max-width:none }
.stage .fill{ left:0; top:0; width:466px; height:538px }
.stage .menu{ left:114px; top:358px; width:239px; height:141px }
.stage .menu-patch{ position:absolute; background:#000 }
.stage .tcursor{ left:123px; width:223px; height:39px }
.stage .sprite{ left:143px; top:246px; width:232px; height:114px }
.stage .bust{ left:10px; top:406px; width:115px; height:115px }
.stage .rowcursor{ width:179px; height:36px }
.stage .cellcursor{ width:60px; height:51px }
.stage .nextarrow{ left:220px; top:510px; width:26px; height:14px }
.stage .cv{ position:absolute; left:0; top:0; width:466px; height:538px; pointer-events:none }
.stage .fade{
  position:absolute; left:0; top:0; width:466px; height:538px;
  background:#000; opacity:1;
  transition:opacity .28s linear;
  pointer-events:none;
}

/* ==========================================================================
   4. 序章四步
   ========================================================================== */
.shots{
  display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
  gap:34px 26px;
  margin:0; padding:0; list-style:none;
  counter-reset:s;
}
.shot img{
  width:100%; max-width:390px;
  border:1px solid var(--line-strong);
  border-radius:24px;
  background:#000;
}
.shot__n{
  margin:16px 0 4px;
  font:500 12px/1 Consolas,monospace; letter-spacing:.2em; color:var(--accent);
}
.shot h3{ margin:0 0 6px; font-size:16px; font-weight:600; letter-spacing:.06em }
.shot p{ margin:0; color:var(--ink-dim); font-size:14.5px }

/* 视频位：还没有录屏素材，先放一个设计过的占位，不放假截图 */
.videoslot{ margin:48px 0 0; max-width:390px }
.videoslot__frame{
  display:grid; place-items:center;
  aspect-ratio:390 / 450;
  border:1px dashed var(--line-strong);
  border-radius:24px;
  background:rgba(185,198,214,.028);
}
.videoslot__frame span{
  font-size:34px; color:var(--ink-mute); opacity:.55;
}
.videoslot figcaption{
  margin-top:14px; text-align:center;
  font-size:13.5px; color:var(--ink-mute); letter-spacing:.04em;
}

/* ==========================================================================
   5. 原版对照画廊
   ========================================================================== */
.gallery{
  display:grid; grid-template-columns:repeat(4,minmax(0,1fr));
  gap:18px;
  margin:0; padding:0; list-style:none;
}
.thumb{
  display:block; width:100%; padding:0;
  border:1px solid var(--line-strong);
  border-radius:8px;
  background:#000;
  cursor:zoom-in;
  overflow:hidden;
  transition:border-color .18s ease, transform .18s ease;
}
.thumb img{ width:100%; height:auto }
.thumb:hover{ border-color:var(--accent-deep); transform:translateY(-2px) }
.thumb:focus-visible{ outline:2px solid var(--accent); outline-offset:2px }

/* ==========================================================================
   6. 折叠的技术说明
   ========================================================================== */
.fold{
  border-top:1px solid var(--line);
  padding:6px 0;
}
.fold:last-of-type{ border-bottom:1px solid var(--line) }
.fold summary{
  cursor:pointer;
  padding:20px 34px 20px 0;
  position:relative;
  font-size:16.5px; font-weight:600; letter-spacing:.04em;
  list-style:none;
  color:var(--ink);
}
.fold summary::-webkit-details-marker{ display:none }
.fold summary::after{
  content:"+";
  position:absolute; right:6px; top:50%; transform:translateY(-50%);
  font:400 22px/1 Consolas,monospace; color:var(--accent);
  transition:transform .2s ease;
}
.fold[open] summary::after{ content:"−" }
.fold summary:hover{ color:#fff }
.fold__body{ padding:0 0 30px; max-width:60em; color:var(--ink-dim) }
.fold__body p{ margin:0 0 18px }
.fold__body p:last-child{ margin-bottom:0 }

.code{
  margin:0 0 22px;
  padding:18px 20px;
  border:1px solid var(--line);
  border-radius:var(--radius);
  background:#0d0e11;
  overflow-x:auto;
}
.code code{
  font-size:13px; line-height:1.75; color:#c8cdd4;
  white-space:pre; display:block;
}

.ticks{ margin:0; padding:0; list-style:none }
.ticks li{
  position:relative; padding:8px 0 8px 26px;
  border-bottom:1px dashed var(--line);
}
.ticks li:last-child{ border-bottom:0 }
.ticks li::before{
  content:"—"; position:absolute; left:0; color:var(--accent-deep);
}

.figure{ margin:8px 0 0 }
.figure img{
  width:100%; max-width:900px;
  border:1px solid var(--line-strong);
  border-radius:8px;
}
.figure figcaption{
  margin-top:12px; font-size:13.5px; color:var(--ink-mute);
}

/* ==========================================================================
   7. 页脚
   ========================================================================== */
.foot{
  position:relative;
  padding:72px 0 88px;
  border-top:1px solid var(--line);
  overflow:hidden;
}
.foot::before{
  content:"";
  position:absolute; inset:0;
  background:url("assets/img/ui/bg-title.jpg") center bottom/cover no-repeat;
  opacity:.06; mix-blend-mode:screen; pointer-events:none;
}
.foot .wrap{ position:relative }
.foot__legal{
  margin:0; max-width:52em;
  font-size:14.5px; line-height:1.95; color:var(--ink-dim);
}
.foot__meta{
  margin:26px 0 0; font-size:14px; color:var(--ink-mute); letter-spacing:.04em;
}
.foot__top{ margin:22px 0 0; font-size:14px }

/* ==========================================================================
   大图查看
   ========================================================================== */
.lightbox{
  position:fixed; inset:0; z-index:60;
  display:grid; place-items:center;
  padding:56px 20px 32px;
  background:rgba(6,6,8,.94);
}
.lightbox__fig{ margin:0; max-width:100%; text-align:center }
.lightbox__fig img{
  margin:0 auto;
  max-width:min(1100px,94vw);
  max-height:76vh; width:auto; height:auto;
  border:1px solid var(--line-strong);
  border-radius:8px;
  background:#000;
}
.lightbox__fig figcaption{
  margin-top:14px; font-size:14px; color:var(--ink-dim);
}
.lightbox__close{
  position:absolute; top:18px; right:20px;
  padding:9px 18px;
  border:1px solid var(--line-strong); border-radius:999px;
  background:rgba(11,11,13,.8); color:var(--ink);
  font:inherit; font-size:14px; cursor:pointer;
}
.lightbox__close:hover{ background:rgba(185,198,214,.12) }

/* ==========================================================================
   滚动淡入
   ========================================================================== */
.reveal{ opacity:0; transform:translateY(14px); transition:opacity .42s ease, transform .42s ease }
.reveal.in{ opacity:1; transform:none }

/* ==========================================================================
   响应式
   ========================================================================== */
@media (max-width:1000px){
  .hero__grid{ grid-template-columns:minmax(0,1fr); gap:48px }
  .hero__device{ justify-self:start }
  .cards{ grid-template-columns:repeat(2,minmax(0,1fr)) }
  .shots{ grid-template-columns:repeat(2,minmax(0,1fr)) }
  .gallery{ grid-template-columns:repeat(3,minmax(0,1fr)) }
}

@media (max-width:860px){
  .play{ grid-template-columns:minmax(0,1fr); gap:40px }
  .sec{ padding:72px 0 }
}

@media (max-width:620px){
  body{ font-size:16px }
  .wrap{ padding:0 18px }
  .sec{ padding:60px 0 }
  .sec__title{ font-size:22px }
  .hero{ padding:64px 0 56px }
  .cards{ grid-template-columns:minmax(0,1fr); gap:28px }
  .shots{ grid-template-columns:minmax(0,1fr); gap:32px }
  .gallery{ grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px }
  .watch__bezel{ padding:12px; border-radius:38px }
  .watch--play .watch__bezel{ padding:11px; border-radius:36px }
  .screen-wrap{ border-radius:26px }
  .fold summary{ font-size:15.5px; padding-right:30px }
  .lightbox{ padding:64px 12px 24px }
}

/* ==========================================================================
   动效偏好 / 打印
   ========================================================================== */
@media (prefers-reduced-motion:reduce){
  *{ transition:none !important; animation:none !important }
  .reveal{ opacity:1; transform:none }
  .thumb:hover{ transform:none }
}
